<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      Shared test plumbing, not a test project: it holds no tests. Marked explicitly so `dotnet test`
      does not try to run it (the same trap IndyPOS.Mock documents).
    -->
    <IsTestProject>false</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <!-- The lowest version any consumer resolves (CloudApi is pinned to 9.0.3); the others unify upward. -->
    <PackageReference Include="Npgsql" Version="9.0.3" />
  </ItemGroup>
</Project>
