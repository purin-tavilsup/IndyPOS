meta {
  name: Get Current User
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/auth/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  # Get Current User

  Returns the currently authenticated user's information.

  ## Response

  ```json
  {
    "userId": "guid",
    "username": "string",
    "firstName": "string",
    "lastName": "string",
    "role": "string"
  }
  ```

  ## Authorization

  Requires valid JWT token. Any authenticated user can access.
}
